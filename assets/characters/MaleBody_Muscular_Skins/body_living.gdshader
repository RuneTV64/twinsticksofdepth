	vec3(0.7843, 0.5882, 0.3686), vec3(0.6706, 0.4902, 0.2941), vec3(0.5608, 0.3961, 0.2275), vec3(0.4431, 0.3098, 0.2000), vec3(0.3333, 0.2314, 0.1804), vec3(0.2314, 0.1608, 0.1686), vec3(0.1490, 0.1020, 0.1294), vec3(0.0745, 0.0510, 0.0863), // CARAMEL_SKIN
	vec3(0.8000, 0.5490, 0.3529), vec3(0.6824, 0.4510, 0.2784), vec3(0.5686, 0.3569, 0.2157), vec3(0.4510, 0.2824, 0.1922), vec3(0.3412, 0.2118, 0.1765), vec3(0.2353, 0.1529, 0.1686), vec3(0.1490, 0.1020, 0.1294), vec3(0.0745, 0.0510, 0.0863), // CARAMEL_FLUSH
	vec3(0.7373, 0.6039, 0.4549), vec3(0.6314, 0.5098, 0.3686), vec3(0.5216, 0.4157, 0.2941), vec3(0.4157, 0.3255, 0.2431), vec3(0.3137, 0.2471, 0.2078), vec3(0.2235, 0.1765, 0.1804), vec3(0.1451, 0.1098, 0.1373), vec3(0.0745, 0.0510, 0.0863), // CARAMEL_OLD
	vec3(0.8549, 0.7020, 0.5412), vec3(0.7569, 0.5961, 0.4510), vec3(0.6549, 0.4902, 0.3686), vec3(0.5294, 0.3843, 0.3098), vec3(0.4078, 0.2863, 0.2627), vec3(0.2863, 0.2000, 0.2275), vec3(0.1804, 0.1255, 0.1686), vec3(0.0863, 0.0627, 0.1059), // CARAMEL_NAIL
	vec3(0.5804, 0.3922, 0.2118), vec3(0.4902, 0.3294, 0.1804), vec3(0.4039, 0.2667, 0.1529), vec3(0.3216, 0.2118, 0.1451), vec3(0.2471, 0.1608, 0.1333), vec3(0.1765, 0.1098, 0.1216), vec3(0.1137, 0.0706, 0.0941), vec3(0.0588, 0.0353, 0.0627), // CARAMEL_FRECKLE
	vec3(0.5176, 0.3451, 0.1882), vec3(0.4353, 0.2902, 0.1608), vec3(0.3569, 0.2353, 0.1412), vec3(0.2863, 0.1882, 0.1373), vec3(0.2196, 0.1412, 0.1255), vec3(0.1529, 0.0980, 0.1137), vec3(0.1020, 0.0627, 0.0863), vec3(0.0510, 0.0314, 0.0549), // CARAMEL_SPOT
	vec3(0.8471, 0.6902, 0.5412), vec3(0.7490, 0.5922, 0.4510), vec3(0.6431, 0.4902, 0.3725), vec3(0.5216, 0.3882, 0.3176), vec3(0.4000, 0.2902, 0.2706), vec3(0.2745, 0.1961, 0.2314), vec3(0.1765, 0.1216, 0.1647), vec3(0.0863, 0.0549, 0.0941), // CARAMEL_PALM
	vec3(0.5804, 0.4392, 0.2980), vec3(0.4863, 0.3686, 0.2431), vec3(0.3961, 0.2980, 0.2000), vec3(0.3137, 0.2353, 0.1765), vec3(0.2392, 0.1765, 0.1529), vec3(0.1686, 0.1216, 0.1294), vec3(0.1098, 0.0784, 0.0980), vec3(0.0549, 0.0392, 0.0627), // CHESTNUT_SKIN
	vec3(0.5961, 0.4078, 0.2824), vec3(0.4980, 0.3412, 0.2314), vec3(0.4039, 0.2745, 0.1922), vec3(0.3216, 0.2157, 0.1725), vec3(0.2471, 0.1647, 0.1529), vec3(0.1725, 0.1137, 0.1294), vec3(0.1098, 0.0745, 0.0980), vec3(0.0549, 0.0392, 0.0627), // CHESTNUT_FLUSH
	vec3(0.5490, 0.4392, 0.3529), vec3(0.4627, 0.3725, 0.2941), vec3(0.3804, 0.3059, 0.2431), vec3(0.3059, 0.2431, 0.2118), vec3(0.2314, 0.1843, 0.1765), vec3(0.1647, 0.1294, 0.1412), vec3(0.1098, 0.0824, 0.1020), vec3(0.0549, 0.0392, 0.0627), // CHESTNUT_OLD
	vec3(0.7294, 0.6118, 0.5020), vec3(0.6431, 0.5216, 0.4196), vec3(0.5529, 0.4314, 0.3490), vec3(0.4549, 0.3412, 0.2941), vec3(0.3529, 0.2549, 0.2471), vec3(0.2471, 0.1765, 0.2039), vec3(0.1569, 0.1098, 0.1490), vec3(0.0745, 0.0549, 0.0902), // CHESTNUT_NAIL
	vec3(0.4235, 0.3137, 0.2118), vec3(0.3569, 0.2627, 0.1804), vec3(0.2902, 0.2157, 0.1529), vec3(0.2314, 0.1725, 0.1333), vec3(0.1765, 0.1294, 0.1176), vec3(0.1255, 0.0902, 0.1020), vec3(0.0824, 0.0588, 0.0745), vec3(0.0392, 0.0275, 0.0471), // CHESTNUT_FRECKLE
	vec3(0.3686, 0.2667, 0.1882), vec3(0.3098, 0.2275, 0.1569), vec3(0.2549, 0.1882, 0.1294), vec3(0.2039, 0.1490, 0.1176), vec3(0.1569, 0.1137, 0.1059), vec3(0.1137, 0.0784, 0.0941), vec3(0.0745, 0.0510, 0.0706), vec3(0.0353, 0.0235, 0.0431), // CHESTNUT_SPOT
	vec3(0.7843, 0.6275, 0.4863), vec3(0.6863, 0.5294, 0.4000), vec3(0.5843, 0.4314, 0.3255), vec3(0.4706, 0.3412, 0.2824), vec3(0.3608, 0.2549, 0.2431), vec3(0.2471, 0.1686, 0.2118), vec3(0.1608, 0.1059, 0.1529), vec3(0.0784, 0.0471, 0.0863) // CHESTNUT_PALM
);

varying vec3 v_body; // rest position on the body in metres (feet at 0, facing +Z), so freckles and hair stay on the skin as he moves

float b2(vec2 a){a=floor(a);return fract(a.x*0.5+a.y*a.y*0.75);}
float b4(vec2 a){return b2(0.5*a)*0.25+b2(a);}
float q2(float a){return a*a;}
float q4(float a){return a*a*a*a;}
void td(float zk,float vk,float u,float v,inout vec3 g){float t=clamp((v+0.004)/(vk+0.004),0.0,1.0),u0=0.004+0.3*zk,uc=mix(u0,zk,t),d=(u-uc)/0.0028,e=exp(-d*d),fa=(1.0-smoothstep(-0.03,-0.01,v))*smoothstep(vk-0.006,vk+0.006,v),sl=(zk-u0)/(vk+0.004);g.x-=1.1*fa*d*e;g.y+=1.1*fa*d*e*sl;float du=(u-zk)/0.008,dv=(v-vk-0.004)/0.008,ek=exp(-du*du-dv*dv);g.x-=du*ek;g.y-=dv*ek;}
void vn(float a,float b,float c,float f,float p,float va,float vb,float u,float v,inout vec3 g){float uc=a+b*v+c*sin(f*v+p),d=(u-uc)/0.0034,e=exp(-d*d),fa=smoothstep(va,va+0.012,v)*(1.0-smoothstep(vb-0.012,vb,v)),k=0.9*fa*d*e;g.x-=k;g.y+=k*(b+c*f*cos(f*v+p));}
void ft(float d0,float d1,float amp,float u,float t,float rf,inout vec3 g){float xi=-0.006+(d0+0.006)*t/d1,d=(u-xi)/0.0036,k=amp*rf/0.0036*2.0*d*exp(-d*d);g.x-=k;g.y+=k*(d0+0.006)/d1;}
void cu(float a,float b,float c,float f,float p,float ua,float ub,float u,float v,inout vec3 g){float vc=a+b*u+c*sin(f*u+p),d=(v-vc)/0.002,e=exp(-d*d),fa=smoothstep(ua,ua+0.008,u)*(1.0-smoothstep(ub-0.008,ub,u)),k=1.1*fa*d*e;g.y+=k;g.x-=k*(b+c*f*cos(f*u+p));g.z+=fa*e;}

float h13(vec3 p){p=fract(p*0.1031);p+=dot(p,p.zyx+31.32);return fract((p.x+p.y)*p.z);}
float vno(vec3 p){vec3 i=floor(p),f=fract(p);f=f*f*(3.0-2.0*f);return mix(mix(mix(h13(i),h13(i+vec3(1,0,0)),f.x),mix(h13(i+vec3(0,1,0)),h13(i+vec3(1,1,0)),f.x),f.y),mix(mix(h13(i+vec3(0,0,1)),h13(i+vec3(1,0,1)),f.x),mix(h13(i+vec3(0,1,1)),h13(i+vec3(1,1,1)),f.x),f.y),f.z);}
float fbm3(vec3 p){return (vno(p)*0.5+vno(p*2.03+3.1)*0.25+vno(p*4.07+7.7)*0.125)/0.875;}
float rdg(vec3 p){return 1.0-abs(vno(p)*2.0-1.0);}
vec3 pal(int r,float ix){return RAMPS[r*8+int(clamp(ix,0.0,7.0))];}

void vertex() {
	// the model stores each vertex's rest position in CUSTOM0.xyz. VERTEX here is already posed by the skeleton, so
	// painting from it would leave freckles and hair hanging in the air as limbs move. A model without that data
	// (all zero) falls back to the posed position.
	v_body = dot(CUSTOM0.xyz, CUSTOM0.xyz) > 0.000001 ? CUSTOM0.xyz : VERTEX;
}

void fragment() {
	vec3 n=normalize(NORMAL);
	float code=floor(COLOR.a*15.0+0.5);
	vec2 uv=UV;
	float w2=UV2.x;
	vec3 rp=vec3(uv.x,uv.y,(COLOR.g-0.5)*0.3);
	float crs=0.0;
	if(code>3.5&&code<7.5){
	float u=uv.x,v=uv.y,sd=w2,kk=abs(sd)*1.3;
	vec3 g=vec3(0.0);
	vec3 dp1=dFdx(VERTEX),dp2=dFdy(VERTEX);
	vec2 d1=dFdx(uv),d2=dFdy(uv);
	float det=d1.x*d2.y-d2.x*d1.y;
	vec3 Tu=vec3(0.0),Tv=vec3(0.0);
	if(abs(det)>0.00000000000001){
	Tu=normalize((dp1*d2.y-dp2*d1.y)/det);
	Tv=normalize((dp2*d1.x-dp1*d2.x)/det);
	}
	if(code>5.5){
	float rf=0.046-0.32*(v-0.04);
	ft(-0.028,0.142,0.085,u,v,rf,g);
	ft(-0.006,0.148,0.065,u,v,rf,g);
	ft(0.011,0.143,0.06,u,v,rf,g);
	ft(0.026,0.134,0.055,u,v,rf,g);
	ft(0.040,0.121,0.05,u,v,rf,g);
	kk=sd*0.75*clamp((v-0.03)/0.03,0.0,1.0)*clamp((0.14-v)/0.035,0.0,1.0);
	}
	else{
	if(sd>0.0){
	td(0.036,-0.098,u,v,g);
	td(0.014,-0.102,u,v,g);
	td(-0.008,-0.099,u,v,g);
	td(-0.029,-0.091,u,v,g);
	vn(-0.0319,-0.397,0.003,110.0,0.0,-0.09,-0.002,u,v,g);
	vn(0.0008,0.233,0.0,0.0,0.0,-0.088,-0.05,u,v,g);
	vn(0.01905,-0.119,0.0025,140.0,1.0,-0.078,-0.004,u,v,g);
	}
	else{
	cu(-0.08556,-0.339,0.003,50.7,2.03,-0.043,0.024,u,v,g);
	cu(-0.06,-0.25,-0.0025,52.0,1.0,-0.022,0.042,u,v,g);
	cu(-0.007,0.0,0.0015,60.0,1.57,-0.03,0.03,u,v,g);
	cu(0.001,0.0,0.0012,70.0,0.4,-0.026,0.026,u,v,g);
	float t=clamp((v+0.068)/0.056,0.0,1.0),uc=0.006+0.034*pow(1.0-t,1.8),d=(u-uc)/0.002,e=exp(-d*d),fa=smoothstep(-0.07,-0.062,v)*(1.0-smoothstep(-0.02,-0.012,v)),k=1.1*fa*d*e;
	g.x+=k;
	g.y+=k*0.034*1.8*pow(1.0-t,0.8)/0.056;
	g.z+=fa*e;
	}
	crs=abs(sd)*g.z;
	}
	n=normalize(n-kk*(g.x*Tu+g.y*Tv));
	}
	float I=ambient+0.98*max(dot(n,normalize(key_dir)),0.0)+0.08*max(n.x*0.7-n.y*0.2+n.z*0.2,0.0)-0.13*crs;
	float nv=code<1.5?w2:0.0;
	bool nail=false;
	float rim=0.0;
	if(nv>0.05){
	float d=atan(uv.y,uv.x);
	if(code>0.5){
	nail=q4((nv-0.61)/0.31)+q4(d/0.98)<1.0;
	if(!nail&&q4((nv-0.575)/0.355)+q4(d/1.16)<1.0)rim=2.0;
	}
	else{
	nail=q2((nv-0.55)/0.32)+q2(d/0.85)<1.0;
	if(!nail&&q2((nv-0.55)/0.39)+q2(d/1.04)<1.0)rim=1.0;
	}
	}
	if(nail)I+=0.11;
	if(code>1.5&&code<3.5)I-=0.5*COLOR.r;
	I+=(b4(floor(FRAGCOORD.xy/pixel_size))-0.5)*0.14;
	bool cl=((code>2.5&&code<3.5)||code>7.5)&&rp.y>0.835&&rp.y<1.035&&abs(rp.x)<0.25;
	float cf=0.0;
	if(code>2.5&&code<3.5){
	if(rp.z>0.05&&rp.y>1.28&&rp.y<1.35){
	float nd=length(vec2(abs(rp.x)-0.102,rp.y-1.314));
	if(nd<0.016)rim=max(rim,nd<0.010?2.0:1.0);
	}
	if(rp.z<-0.06){
	float cx=rp.x/0.0055;
	cf=0.38*exp(-cx*cx)*smoothstep(0.872,0.9,rp.y)*(1.0-smoothstep(0.93,0.98,rp.y));
	}
	}
	// ---------------- living skin
	vec3 bp=v_body;
	vec3 sp=bp+look_seed*vec3(1.31,0.71,2.17);
	float dth=b4(floor(FRAGCOORD.xy/pixel_size));
	float base=floor(clamp((1.1-(I-cf))/1.1,0.0,0.999)*8.0);
	int tb=TONES+skin_tone*7;
	bool aged=variant==3;
	// where on the body this pixel is (see the part codes above)
	bool head=code<0.5&&bp.y>1.55;
	bool face=head&&bp.z>0.015;
	bool neck=code<0.5&&bp.y>1.44&&bp.y<=1.55&&abs(bp.x)<0.1;
	bool fore=code<0.5&&bp.y>0.8&&bp.y<1.22&&abs(bp.x)>0.16;
	bool shin=code<0.5&&bp.y<0.56;
	bool thigh=code>7.5;
	bool uarm=code>1.5&&code<2.5&&bp.y<1.6;
	bool ear=code>1.5&&code<2.5&&bp.y>=1.6;
	bool torso=code>2.5&&code<3.5;
	bool hand=code>3.5&&code<5.5;
	bool foot=(code>5.5&&code<7.5)||(code>0.5&&code<1.5);
	int r=aged?tb+2:tb;
	float ix=base+rim;
	if(nail){
		r=tb+3;
	}else if(cl){
		r=CLOTH;
		ix=base+1.0+rim;
	}else{
		// a little skin texture, and a living flush where the blood sits close: ears, cheeks, nose, knuckles,
		// elbows, knees and the soles of the feet
		float gh=h13(vec3(floor(FRAGCOORD.xy/pixel_size),7.0));
		ix+=gh<grit*0.5?1.0:(gh<grit?-1.0:0.0);
		float cheek=face?exp(-(q2(abs(bp.x)-0.045)/0.0004+q2(bp.y-1.63)/0.0008)):0.0;
		float nose=face?exp(-(q2(bp.x)/0.00015+q2(bp.y-1.66)/0.0006))*smoothstep(0.05,0.075,bp.z):0.0;
		float knee=(shin||thigh)?exp(-q2(bp.y-0.52)/0.0012)*smoothstep(0.0,0.04,bp.z-0.0):0.0;
		float elbow=fore?smoothstep(1.06,1.14,bp.y)*smoothstep(0.0,-0.03,bp.z):0.0;
		float fl=(ear?0.75:0.0)+cheek*0.7+nose*0.6+knee*0.5+elbow*0.45+(hand?0.3:0.0)+(foot?0.35:0.0);
		if(fl*(0.55+0.45*fbm3(sp*9.0))>0.3+dth*0.35)r=tb+1;
		// palms and soles (the palm side of the hand plate, the underside of the foot and toes) have their own,
		// lighter color on the deeper tones; on lighter tones it's the same as the skin
		bool palm=(hand&&w2<0.0)||(code>5.5&&code<7.5&&w2<0.5)||(code>0.5&&code<1.5&&bp.y<0.012);
		if(palm&&HAS_PALM[skin_tone])r=tb+6;

		// body hair: where it grows, how thick for this look, and a pixel-sized strand pattern anchored to the body
		float chest=torso?smoothstep(0.0,0.04,bp.z)*smoothstep(1.19,1.27,bp.y)*(1.0-smoothstep(1.40,1.46,bp.y))*(1.0-smoothstep(0.09,0.16,abs(bp.x))):0.0;
		float trail=torso?smoothstep(0.02,0.06,bp.z)*smoothstep(0.96,1.04,bp.y)*(1.0-smoothstep(1.2,1.27,bp.y))*(1.0-smoothstep(0.012,0.035,abs(bp.x))):0.0;
		float upback=torso?smoothstep(0.0,-0.05,bp.z)*smoothstep(1.3,1.42,bp.y)*0.35:0.0;
		float limb=(fore?0.9:0.0)+(shin?0.85:0.0)+(thigh?0.6:0.0)+(uarm?0.22:0.0)+(hand?0.35:0.0)+(foot?0.15:0.0);
		float bodyHair=max(max(chest,trail),max(upback,limb));
		// stubble and beard: jaw, chin, cheeks down to the neck
		float beard=head?(1.0-smoothstep(1.62,1.665,bp.y))*smoothstep(-0.035,0.005,bp.z):0.0;
		beard=max(beard,neck?smoothstep(0.015,0.045,bp.z)*smoothstep(1.49,1.53,bp.y)*0.7:0.0);
		float bodyAmt=variant==2?1.0:(variant==3?0.45:(variant==0||variant==4?0.28:0.05));
		float beardAmt=variant==2?1.0:(variant==3?0.55:(variant==0||variant==4?0.3:0.12));
		float patchy=0.55+0.45*fbm3(sp*7.0+2.0);
		float hd=bodyHair*bodyAmt*patchy*(hair_color==4?GREY_SHOW[skin_tone]:1.0);   // grey hair on dark skin is sparse speckle
		float bd=beard*beardAmt*(0.7+0.3*fbm3(sp*12.0));
		float strand=h13(floor(sp*vec3(320.0,130.0,320.0))+look_seed);   // short strands running down the body
		float stub=h13(floor(sp*420.0)+look_seed+5.0);
		int hair=HAIR_BLOND+hair_color;

		// freckles: dense on the face, shoulders, upper back and arms, in sun-catching clusters
		if(variant==0){
			float top=torso?smoothstep(1.3,1.45,bp.y)*(0.7+0.3*smoothstep(0.0,-0.04,bp.z)):0.0;
			float fz=(face?1.0:0.0)+(head&&!face?0.35:0.0)+top+(uarm?0.85:0.0)+(fore?0.6:0.0)+(hand?0.45:0.0)+(torso?0.15:0.0)+(neck?0.4:0.0)+(ear?0.3:0.0)+0.06;
			fz*=0.45+0.55*fbm3(sp*5.0+9.0);
			vec3 fc=floor(sp*125.0);
			float fh=h13(fc+look_seed*0.37);
			if(fh<fz*0.29){r=tb+4;ix=base+(fh<fz*0.08?1.0:0.0)+rim;}
		}
		// vitiligo: pale patches where the skin has lost its color. Sharp-edged, mostly mirrored left and right, and
		// most often on the hands and fingers, wrists, around the mouth, elbows, knees and feet, with a few elsewhere.
		if(variant==4){
			bool finger=code<0.5&&bp.y<=0.8&&abs(bp.x)>0.16;
			float mouth=face?exp(-(q2(bp.x)/0.0016+q2(bp.y-1.6)/0.0012)):0.0;
			float wrist=fore?smoothstep(0.93,0.86,bp.y):0.0;
			float vz=(hand?1.0:0.0)+(finger?1.0:0.0)+wrist*0.9+mouth*0.9+(face?0.3:0.0)+elbow*0.8+knee*0.8+(foot?0.75:0.0)
				+(neck?0.35:0.0)+(torso?0.22:0.0)+(uarm?0.2:0.0)+((thigh||shin)?0.2:0.0)+((head&&!face)?0.25:0.0)+(ear?0.3:0.0);
			vec3 vp=vec3(abs(bp.x),bp.y,bp.z)+look_seed*vec3(0.61,0.37,0.83);   // mirrored, so patches tend to match
			float vn=fbm3(vp*4.5)+0.1*vno(vp*30.0);   // big soft shapes with a ragged edge
			float th=0.78-0.3*clamp(vz,0.0,1.0);
			if(vn>th){r=VITILIGO;ix=base+rim;}
			else if(vn>th-0.025&&h13(floor(bp*200.0))>0.4)ix+=1.0;   // a slightly darker rim at the edge
		}
		// old: sallow thinner skin (the old ramp), wrinkles, age spots, and grey hair
		if(aged){
			float wz=(neck?1.0:0.0)+(face?0.35:0.0)+(face&&bp.y>1.69?0.25:0.0)+(fore||hand?0.55:0.0)+(torso&&bp.z>0.0&&bp.y<1.2?0.35:0.0)+(ear?0.4:0.0)+0.2;
			float wr=pow(rdg(sp*vec3(16.0,70.0,16.0)),10.0)+0.5*pow(rdg(sp*vec3(40.0,40.0,40.0)+3.0),14.0);
			if(wr*wz>0.26)ix+=1.0;
			if(neck&&wr*wz>0.5)ix+=1.0;   // deepest on the neck
			float sz=(head?1.0:0.0)+(hand?1.0:0.0)+(fore?0.8:0.0)+(torso&&bp.y>1.35?0.55:0.0)+(uarm?0.45:0.0)+0.12;
			vec3 sc=sp*38.0;
			vec3 sj=fract(sc)-0.5-(vec3(h13(floor(sc)+1.0),h13(floor(sc)+2.0),h13(floor(sc)+3.0))-0.5)*0.4;
			if(h13(floor(sc)+look_seed)<sz*0.3&&length(sj)<0.26+0.18*h13(floor(sc)+4.0)){r=tb+5;ix=base+rim;}
		}
		// hair on top of all that: the strands themselves, and a faint darkening of the skin they grow from
		// From a distance body hair reads as a darker, broken-up shade of the skin with the odd strand catching the
		// eye, so most hair pixels just darken the skin and only a few take the hair color. Fair hair shows less.
		float show=hair_color>=2?1.0:(hair_color==1?0.7:0.45);
		if(r!=tb+5&&r!=tb+4||variant==0){
			if(stub<bd*0.28){r=hair;ix=base;}
			else if(stub<bd*0.8*show)ix+=1.0;
			else if(strand<hd*(variant==2?0.2:0.12)){r=hair;ix=base;}
			else if(strand<hd*(variant==2?0.75:0.5)*show)ix+=1.0;
		}
	}
	vec3 c=pal(r,ix);
	ALBEDO=pow(c,vec3(2.2));
}
