static var _texture: ImageTexture


static func texture() -> ImageTexture:
	if _texture == null:
		var image := Image.new()
		image.load_png_from_buffer(Marshalls.base64_to_raw(DATA))
		_texture = ImageTexture.create_from_image(image)
	return _texture
